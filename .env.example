# AFXX Vision AI Configuration

# Flask Configuration
FLASK_ENV = production
FLASK_DEBUG = False
SECRET_KEY = afxx-vision-ai-secret-2024

# Server Configuration
HOST = 127.0.0.1
PORT = 5000
THREADED = True

# YOLOv8 Model
MODEL_PATH = yolov8n.pt
CONFIDENCE_THRESHOLD = 0.45

# File Upload
MAX_FILE_SIZE = 52428800  # 50MB in bytes
UPLOAD_FOLDER = static/uploads
SCREENSHOT_FOLDER = static/screenshots

# Detection Settings
DETECTION_CLASSES = person,bicycle,car,motorbike,bottle,cup,knife,cell phone
MAX_HISTORY = 1000
